<request type="quality">
  <goal>Run quality checks on source files, report issues, then format only after approval.</goal>

  <inputs>
    <source-files required="true" pass-as-parameter="true">
      <allow-directories state="disabled" />
      <only-unstaged state="false" />
      <only-staged state="false" />
      <entire-codebase state="enabled" />
      <exclude paths="**.build,**.swiftpm,**.xcodeproj,**/node_modules,**/.next,**/dist,**/.git" />
    </source-files>
  </inputs>

  <policy>
    <add-ignore-directives when="only-when-particularly-relevant" />
  </policy>

  <execution>
    <order strategy="lint-first,approval,format,post-lint" />
    <gate id="approval" require="explicit-user-approval-before-writing" />
  </execution>

  <report>
    <destination path="./quality.$AIPROVIDER-$AIPROVIDER_MODEL.yml" />
    <content include="files,commands,exit-codes,issues-by-severity,auto-fixable,manual-fixes,summary" />
  </report>

  <skills>
    <resolve strategy="dynamic" source="discover-skills.sh" max="10" />
  </skills>
</request>
